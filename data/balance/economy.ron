// Posted-price market tunables (SPEC §12; ADR 0007 §5).
EconomyConfig(
    // Margin over unit cost, per-mille: the cost-plus floor is
    // ceil((inputs at market prices + overhead) × 1.3 / batch output).
    markup_per_mille: 300,
    // Fixed non-input cost per batch, mills (rent/wear stand-in until
    // Phases 5–6 model them).
    overhead_mills_per_batch: 200,
    // Daily posted-price movement: per-mille of the current price
    // (at least 1 mill) — the controller's bounded step.
    controller_step_per_mille: 50,
    // Stock target in batches of output: above → cut, below → raise.
    // Doubles as the firm-to-firm procurement fill target for inputs.
    inventory_target_batches: 6,
    // Absolute posted-price bounds, mills.
    min_price_mills: 1,
    max_price_mills: 5000,
)
