// Housing (SPEC §12; ADR 0009 §§3, 5).
HousingConfig(
    // Landlord cost basis and margin: rent asks start near 50 mills/day.
    upkeep_mills_per_day: 40,
    rent_margin_per_mille: 250,
    // A homeless bidder offers 0.8% of their savings as daily rent.
    rent_bid_per_mille: 8,
    // The vacancy controller: above 20% vacancy the ask steps down 5%,
    // below it steps up (floored at cost-plus).
    rent_vacancy_target_per_mille: 200,
    rent_step_per_mille: 50,
    purchase_period_days: 10,
    // The price floor; the measured clearing average anchors after the
    // first sale.
    home_price_mills: 30000,
    // A buyer needs 30% of the price in savings and bids 1.5x of them
    // (leveraged — the bank funds the stretch); financing is cash-first
    // with mortgages capped at 70% of price.
    buyer_savings_per_mille: 300,
    home_bid_per_mille: 1500,
    mortgage_ltv_per_mille: 700,
    // Builders start homes when the price clears cost + financing by 30%.
    construction_margin_per_mille: 300,
)
