// Firm kinds (ADR 0007 §§1-2, 7; ADR 0008 §§1, 7). Order here IS the
// stable firm-kind id. Genesis creates `count` instances per kind, seeds
// cash (recorded as issuance) and stock (recorded as produced), and
// places each instance as a `location_kind_id` location (every firm is a
// place — workers commute there). `positions` are worker slots;
// `min_workers` must be present for a batch to start. A `retail` block
// makes the firm sell its output good to citizens on site.
FirmsConfig(kinds: [
    FirmDef(id: "farm",   count: 2, recipe_id: "harvest_grain",
            initial_cash_mills: 50000, initial_inventory: [], initial_price_mills: 40,
            location_kind_id: "farm", positions: 4, min_workers: 1, retail: None),
    FirmDef(id: "well",   count: 2, recipe_id: "draw_water",
            initial_cash_mills: 50000, initial_inventory: [], initial_price_mills: 25,
            location_kind_id: "well_site", positions: 3, min_workers: 1, retail: None),
    FirmDef(id: "forest", count: 1, recipe_id: "fell_timber",
            initial_cash_mills: 50000, initial_inventory: [], initial_price_mills: 70,
            location_kind_id: "forest_camp", positions: 4, min_workers: 1, retail: None),
    FirmDef(id: "mill",   count: 2, recipe_id: "mill_flour",
            initial_cash_mills: 60000,
            initial_inventory: [GoodQty(good_id: "grain", quantity: 40)],
            initial_price_mills: 90,
            location_kind_id: "mill", positions: 4, min_workers: 1, retail: None),
    FirmDef(id: "bakery", count: 3, recipe_id: "bake_bread",
            initial_cash_mills: 80000,
            initial_inventory: [GoodQty(good_id: "flour", quantity: 60), GoodQty(good_id: "water", quantity: 60), GoodQty(good_id: "bread", quantity: 40)],
            initial_price_mills: 220,
            location_kind_id: "bakery", positions: 5, min_workers: 2,
            retail: Some(RetailDef(need_id: "hunger", gain_per_unit: 450000, use_ticks: 30))),
    FirmDef(id: "woodyard", count: 1, recipe_id: "split_firewood",
            initial_cash_mills: 60000,
            initial_inventory: [GoodQty(good_id: "timber", quantity: 20), GoodQty(good_id: "firewood", quantity: 30)],
            initial_price_mills: 130,
            location_kind_id: "woodyard", positions: 4, min_workers: 1,
            retail: Some(RetailDef(need_id: "shelter", gain_per_unit: 500000, use_ticks: 20))),
    FirmDef(id: "builder", count: 1, recipe_id: "build_home",
            initial_cash_mills: 90000,
            initial_inventory: [GoodQty(good_id: "timber", quantity: 30)],
            initial_price_mills: 30000,
            location_kind_id: "builder_yard", positions: 4, min_workers: 2, retail: None),
])
