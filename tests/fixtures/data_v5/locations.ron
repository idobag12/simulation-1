// Location kinds (ADR 0006 §2): abstract nodes, no map until Phase 9.
// Order here IS Location::kind (the stable integer id, SPEC §8) — the
// list only grows at the end. per_tick values are per-million need units
// gained per tick performing.
//
// Phase 4 (ADR 0007 §§1, 7): hunger and shelter are ECONOMIC now — the
// free hunger satisfiers (tavern, well) and the free home shelter
// satisfier are gone; bread and firewood purchases replaced them. The
// bakery/woodyard kinds have count 0 and no satisfiers: their instances
// are created by firm genesis, and citizens interact with them through
// the retail offer, not a satisfier.
LocationsConfig(kinds: [
    LocationKindDef(id: "home", is_home: true, count: 0, satisfies: [
        // A full night (~8h = 480 ticks) restores rest from empty.
        SatisfierDef(need_id: "rest",   per_tick: 2100),
        SatisfierDef(need_id: "safety", per_tick: 2000),
    ]),
    LocationKindDef(id: "tavern", is_home: false, count: 3, satisfies: [
        SatisfierDef(need_id: "social", per_tick: 7000),
    ]),
    LocationKindDef(id: "plaza", is_home: false, count: 2, satisfies: [
        SatisfierDef(need_id: "social",  per_tick: 5000),
        SatisfierDef(need_id: "purpose", per_tick: 2500),
    ]),
    LocationKindDef(id: "well", is_home: false, count: 2, satisfies: [
        // The village well is a gathering spot; drinking water itself is
        // the water good in the production chain.
        SatisfierDef(need_id: "social", per_tick: 2000),
    ]),
    LocationKindDef(id: "shrine", is_home: false, count: 1, satisfies: [
        SatisfierDef(need_id: "purpose", per_tick: 6000),
        SatisfierDef(need_id: "esteem",  per_tick: 4500),
    ]),
    LocationKindDef(id: "bakery",   is_home: false, count: 0, satisfies: []),
    LocationKindDef(id: "woodyard", is_home: false, count: 0, satisfies: []),
])
